# Grok 注册机 - 环境变量模板
# 复制为 .env 并填入真实值
# 注意：真实进程环境变量优先于 .env；.env 不会进入 Docker 镜像

# Web 控制台（Docker Compose 必填）
GROK_REG_WEB_TOKEN=
GROK_REG_FLASK_SECRET=
GROK_REG_BIND_HOST=127.0.0.1
GROK_REG_HOST_PORT=5000

# CloudMail 管理后台
CLOUDMAIL_URL=
CLOUDMAIL_ADMIN_EMAIL=
CLOUDMAIL_PASSWORD=

# grok2api App Key
GROK2API_APP_KEY=
